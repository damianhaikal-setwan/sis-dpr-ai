    { "name": "AI_RATE_LIMITER", "namespace_id": "9382611", "simple": { "limit": 12, "period": 60 } }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://sis-dpr.pages.dev",
    "SUPABASE_URL": "https://GANTI_PROJECT.supabase.co",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8"
  }
}
