{
  // STAGING ONLY: never change this name to production during diagnosis.
  "name": "sis-dpr-ai-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
